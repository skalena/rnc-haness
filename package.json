{
  "name": "@skalena/rnc",
  "version": "0.7.1",
  "description": "RNC Harness CLI — spec-driven modernization of legacy systems into testable, containerized architectures. Legacy analysis comes from RNC via MCP; the workflow is fixed, the target stack is composable.",
  "type": "module",
  "bin": {
    "rnc": "dist/cli.js"
  },
  "files": [
    "dist",
    "harness",
    "skills"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "keywords": [
    "rnc",
    "legacy-modernization",
    "spec-driven-development",
    "mcp",
    "cli",
    "codegen"
  ],
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skalena/rnc-haness.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "rnc": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "picocolors": "^1.0.1",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.0"
  }
}
